{
  "name": "mine-operations-leaflet-pcf",
  "version": "1.0.0",
  "description": "Read-only mine equipment map for Power Apps Canvas, built with Leaflet.",
  "scripts": {
    "build": "pcf-scripts build",
    "clean": "pcf-scripts clean",
    "lint": "pcf-scripts lint",
    "lint:fix": "pcf-scripts lint fix",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run tests/data.test.ts",
    "test:browser": "playwright test",
    "build:production": "pcf-scripts build --buildMode production"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@microsoft/eslint-plugin-power-apps": "^0.2.51",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.5",
    "@types/powerapps-component-framework": "^1.3.16",
    "eslint-plugin-promise": "^7.1.0",
    "globals": "^15.15.0",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
